# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Flutterwave (MTN MoMo, Airtel Money, Cards)
# Get keys from: https://dashboard.flutterwave.com/settings/apis
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxx

# Stripe (International Cards) - Optional
# Get keys from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxx

# Resend (Email Service) - Server-side only
# Get key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx
