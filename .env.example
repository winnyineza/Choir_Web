# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Flutterwave (MTN MoMo, Airtel Money, Cards)
# Get keys from: https://dashboard.flutterwave.com/settings/apis
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxx

# Gmail SMTP (Email Service)
# 1. Enable 2-Step Verification on Gmail: https://myaccount.google.com/security
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character password below
GMAIL_USER=theserenadeschoir@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Admin Email Notifications (comma-separated)
ADMIN_NOTIFICATION_EMAILS=admin@example.com

# Finance Team Emails (for overdue contribution reports)
FINANCE_NOTIFICATION_EMAILS=finance@example.com

# Send event reminders to all members (true/false)
SEND_MEMBER_REMINDERS=false

# Supabase (for Netlify Functions - server-side access)
# Set these in Netlify Dashboard -> Site Settings -> Environment Variables
# SUPABASE_URL is the same as VITE_SUPABASE_URL but without the VITE_ prefix
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Web Push (VAPID keys for PWA push notifications)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
