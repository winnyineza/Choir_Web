# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Flutterwave (MTN MoMo, Airtel Money, Cards)
# Get keys from: https://dashboard.flutterwave.com/settings/apis
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxx

# Resend (Email Service) - Server-side only
# Get key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxx

# Email sender address (must be verified in Resend)
FROM_EMAIL=tickets@yourdomain.com

# Admin Email Notifications
# Comma-separated list of admin emails to receive reminders
ADMIN_NOTIFICATION_EMAILS=admin@example.com

# Finance Team Emails (for overdue contribution reports)
FINANCE_NOTIFICATION_EMAILS=finance@example.com

# Send event reminders to all members (true/false)
SEND_MEMBER_REMINDERS=false

# Supabase Service Role Key (for server-side access)
# Get from: Supabase Dashboard -> Settings -> API -> Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
